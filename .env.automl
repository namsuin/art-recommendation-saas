# Google AutoML Vision 설정
# 커스텀 모델 학습 후 아래 값들을 설정하세요

# Google Cloud 프로젝트 ID
AUTOML_PROJECT_ID=your-gcp-project-id

# 학습된 모델 이름 (예: projects/PROJECT_ID/locations/us-central1/models/MODEL_ID)
AUTOML_MODEL_NAME=projects/your-project/locations/us-central1/models/your-model-id

# Google Cloud 서비스 계정 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./google-vision-key.json

# 커스텀 모델 사용 여부 (true/false)
USE_CUSTOM_MODEL=false

# Cloud Storage 버킷 (학습 데이터용)
AUTOML_TRAINING_BUCKET=your-training-bucket

# 모델 학습 예산 (시간 단위, 무료 티어: 8시간)
AUTOML_TRAIN_BUDGET=8000